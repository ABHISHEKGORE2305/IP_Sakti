# LLM provider: at least one key is required (Groq is preferred when both are set)
GROQ_API_KEY=<groq-api-key>
GEMINI_API_KEY=<gemini-api-key>

QDRANT_URL=<qdrant-cloud-endpoint>
QDRANT_API_KEY=<qdrant-api-key>

# Admin routes (/api/admin/*) are disabled until this is set. Use a long
# random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
ADMIN_API_KEY=

# Per-client-IP request limits (0 disables a limit)
# RATE_LIMIT_LLM_PER_MIN=30
# RATE_LIMIT_ESCALATE_PER_HOUR=5
# RATE_LIMIT_ADMIN_PER_MIN=10

# Logging: "json" (one object per line, default) or "text" for local reading
# LOG_FORMAT=json
# LOG_LEVEL=INFO
